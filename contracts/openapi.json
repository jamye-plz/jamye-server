    "/api/v1/chatrooms/{chatroom_id}/messages": {
      "get": {
        "operationId": "C2",
        "responses": {
          "200": {
            "description": "Success status from the owner contribution"
          }
        },
        "summary": "Selected C2 operation",
        "x-jamye-owner-contribution": "contracts/contributions/task-6b/dto/operations.json"
      },
      "post": {
        "operationId": "C4",
        "parameters": [
          {
            "description": "Target chatroom",
            "in": "path",
            "name": "chatroom_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Optional; when present it must exactly equal body client_msg_id",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          },
          "description": "Stable idempotent message command",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalMessage"
                }
              }
            },
            "description": "D8=A same-payload retry; existing canonical message"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalMessage"
                }
              }
            },
            "description": "New canonical message"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bearer authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Membership is required without resource disclosure"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "D8=A client_msg_id was reused with a different logical payload"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Content or Idempotency-Key validation failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Required PostgreSQL dependency is unavailable"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "tags": [
          "messages"
        ]
      }
    },
    "/api/v1/chatrooms/{chatroom_id}/read": {
      "post": {
        "operationId": "C3",
        "responses": {
          "200": {
            "description": "Success status from the owner contribution"

      }
    },
    "/api/v1/conversations/{conversation_id}/events": {
      "get": {
        "operationId": "S1",
        "parameters": [
          {
            "description": "Conversation to recover",
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Opaque last-applied server cursor",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bounded page size",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Required current or previous contract version",
            "in": "header",
            "name": "X-Jamye-Contract-Version",
            "required": true,
            "schema": {
              "enum": [
                "1",
                "0"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            },
            "description": "Version-projected delta page",
            "headers": {
              "X-Jamye-Contract-Version": {
                "description": "Accepted contract version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bearer authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Membership is required without resource disclosure"
          },
          "426": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Requested or persisted event version cannot converge safely"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Required PostgreSQL dependency is unavailable"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ],
        "tags": [
          "sync"
        ]
      }
    },

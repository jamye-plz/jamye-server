          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "type": "object"
    },
    "DenormalizedMessage": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "client_msg_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "media": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        },
        "sender_avatar_url": {
          "maxLength": 512,
          "type": [
            "string",
            "null"
          ]
        },
        "sender_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sender_nickname": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "user",
            "system"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "chatroom_id",
        "sender_id",
        "sender_nickname",
        "sender_avatar_url",
        "client_msg_id",
        "body",
        "type",
        "created_at",
        "media"
      ],
      "type": "object"
    },
    "DenormalizedMessagePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/DenormalizedMessage"
          },
          "type": "array"
        },

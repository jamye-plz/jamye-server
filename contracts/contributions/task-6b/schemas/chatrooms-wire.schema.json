{
  "$defs": {
    "Chatroom": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "group_id": {
          "format": "uuid",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "topic_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "main",
            "topic"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "group_id",
        "type",
        "topic_id",
        "created_at"
      ],
      "type": "object"
    },
    "ChatroomPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {

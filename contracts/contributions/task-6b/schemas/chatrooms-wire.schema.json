          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "type": "object"
    },
    "ReadCursorIn": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object"
    },
    "ReadMarker": {
      "additionalProperties": false,
      "properties": {
        "chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "last_read_cursor": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "chatroom_id",
        "last_read_cursor",
        "updated_at"
      ],
      "type": "object"
    }

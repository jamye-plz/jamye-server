{
  "$defs": {
    "BlockCreated": {
      "additionalProperties": false,
      "properties": {
        "blocked_at": { "format": "date-time", "type": "string" },
        "user_id": { "format": "uuid", "type": "string" }
      },
      "required": ["user_id", "blocked_at"],
      "type": "object"
    },
    "BlockedUser": {
      "additionalProperties": false,
      "properties": {
        "avatar_url": { "type": ["string", "null"] },
        "blocked_at": { "format": "date-time", "type": "string" },
        "nickname": { "type": "string" },
        "user_id": { "format": "uuid", "type": "string" }
      },
      "required": ["user_id", "nickname", "avatar_url", "blocked_at"],
      "type": "object"
    },
    "BlockedUserList": {
      "additionalProperties": false,
      "properties": {
        "items": { "items": { "$ref": "#/$defs/BlockedUser" }, "type": "array" }
      },
      "required": ["items"],
      "type": "object"
    },
    "ReportCreate": {
      "additionalProperties": false,
      "properties": {
        "message_id": { "format": "uuid", "type": "string" },
        "reason": {
          "enum": [
            "spam",
            "harassment",
            "sexual_content",
            "violence",
            "hate",
            "illegal",
            "other"
          ],
          "type": "string"
        },
        "target_type": { "enum": ["message", "user"], "type": "string" },
        "user_id": { "format": "uuid", "type": "string" }
      },
      "required": ["target_type", "reason"],
      "type": "object"
    },
    "ReportCreated": {
      "additionalProperties": false,
      "properties": {
        "created_at": { "format": "date-time", "type": "string" },
        "id": { "format": "uuid", "type": "string" },
        "status": { "const": "open", "type": "string" }
      },
      "required": ["id", "status", "created_at"],
      "type": "object"
    }
  },
  "$id": "https://contracts.jamye.test/task-20/moderation-wire.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Reports, user blocks and account suspension wire contribution (message_id is required when target_type is message, user_id when it is user)",
  "title": "Task-20 UGC moderation wire contribution",
  "type": "object"
}

{
  "$defs": {
    "CanonicalMessage": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "client_msg_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "description": "UTC ISO 8601 timestamp.",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/MessageAttachment"
          },
          "type": "array"
        },
        "sender_avatar_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sender_nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/MessageKind"
        }
      },
      "required": [
        "id",
        "chatroom_id",
        "type",
        "created_at",
        "media"
      ],
      "type": "object"
    },
    "MessageAttachment": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "duration": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "media_upload_id": {
          "format": "uuid",
          "type": "string"
        },
        "position": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "poster_media_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "media_upload_id",
        "type",
        "byte_size",
        "position",
        "poster_media_id"
      ],
      "type": "object"
    },
    "MessageCreatedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/CanonicalMessage"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "description": "UTC ISO 8601 timestamp.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/MessageCreatedType"
        },
        "version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "event_id",
        "conversation_id",
        "cursor",
        "occurred_at",
        "data"
      ],
      "type": "object"
    },
    "MessageCreatedType": {
      "enum": [
        "message.created"
      ],
      "type": "string"
    },
    "MessageDeletedData": {
      "additionalProperties": false,
      "properties": {
        "chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "deleted_at": {
          "type": "string"
        },
        "deleted_by": {
          "format": "uuid",
          "type": "string"
        },
        "group_id": {
          "format": "uuid",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "chatroom_id",
        "group_id",
        "deleted_at",
        "deleted_by",
        "reason"
      ],
      "type": "object"
    },
    "MessageDeletedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/MessageDeletedData"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/MessageDeletedType"
        },
        "version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "event_id",
        "conversation_id",
        "cursor",
        "occurred_at",
        "data"
      ],
      "type": "object"
    },
    "MessageDeletedType": {
      "enum": [
        "message.deleted"
      ],
      "type": "string"
    },
    "MessageKind": {
      "enum": [
        "user",
        "system"
      ],
      "type": "string"
    },
    "ServerControlFrame": {
      "oneOf": [
        {
          "properties": {
            "conversation_id": {
              "format": "uuid",
              "type": "string"
            },
            "request_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "subscribed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "conversation_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "conversation_id": {
              "format": "uuid",
              "type": "string"
            },
            "request_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "unsubscribed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "conversation_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "nonce": {
              "type": "string"
            },
            "type": {
              "const": "pong",
              "type": "string"
            }
          },
          "required": [
            "type",
            "nonce"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "request_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "request_id",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "TopicCreatedData": {
      "additionalProperties": false,
      "properties": {
        "author_id": {
          "format": "uuid",
          "type": "string"
        },
        "chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "group_id": {
          "format": "uuid",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "topic_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "group_id",
        "chatroom_id",
        "author_id",
        "title"
      ],
      "type": "object"
    },
    "TopicCreatedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TopicCreatedData"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TopicCreatedType"
        },
        "version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "event_id",
        "conversation_id",
        "cursor",
        "occurred_at",
        "data"
      ],
      "type": "object"
    },
    "TopicCreatedType": {
      "enum": [
        "topic.created"
      ],
      "type": "string"
    },
    "TopicDeletedData": {
      "additionalProperties": false,
      "properties": {
        "announcement_message_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": "string"
        },
        "deleted_by": {
          "format": "uuid",
          "type": "string"
        },
        "group_id": {
          "format": "uuid",
          "type": "string"
        },
        "topic_chatroom_id": {
          "format": "uuid",
          "type": "string"
        },
        "topic_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "topic_chatroom_id",
        "group_id",
        "deleted_at",
        "deleted_by"
      ],
      "type": "object"
    },
    "TopicDeletedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TopicDeletedData"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TopicDeletedType"
        },
        "version": {
          "format": "uint8",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "type",
        "event_id",
        "conversation_id",
        "cursor",
        "occurred_at",
        "data"
      ],
      "type": "object"
    },
    "TopicDeletedType": {
      "enum": [
        "topic.deleted"
      ],
      "type": "string"
    }
  },
  "$id": "https://contracts.jamye.local/realtime/server-frame.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ServerControlFrame"
    },
    {
      "$ref": "#/$defs/MessageCreatedEvent"
    },
    {
      "$ref": "#/$defs/TopicCreatedEvent"
    },
    {
      "$ref": "#/$defs/MessageDeletedEvent"
    },
    {
      "$ref": "#/$defs/TopicDeletedEvent"
    }
  ],
  "title": "Jamye realtime server frames"
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Task8BucketLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::jamye-task8-media"
      ]
    },
    {
      "Sid": "Task8PrivateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::jamye-task8-media/*"
      ]
    }
  ]
}

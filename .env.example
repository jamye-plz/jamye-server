# Local development example. Values are intentionally empty; use .env.local for
# actual credentials. For optional defaults, delete the key line rather than
# leaving it empty. Full production configuration is owned by src/config/**.

# Runtime mode. Required: development, test, or production. Owner: src/config/mod.rs.
JAMYE_ENVIRONMENT=

# API listen socket in IP:PORT form. Optional; default: 127.0.0.1:3000. Owner: src/config/mod.rs.
JAMYE_LISTEN_ADDR=

# Exact proxy IPs, comma-separated. Optional; default: unset (trust nobody). Owner: src/config/mod.rs.
# Only a single-value X-Forwarded-For from a listed TCP peer is used.
JAMYE_TRUSTED_PROXIES=

# Grace period allowed for in-flight requests during shutdown. Optional; default: 20 seconds. Owner: src/config/mod.rs.
JAMYE_SHUTDOWN_GRACE_SECONDS=

# Per-dependency readiness probe timeout in milliseconds. Optional; default: 1000 ms. Owner: src/config/mod.rs.
JAMYE_READINESS_TIMEOUT_MS=

# PostgreSQL connection URL. Required and authoritative for readiness. Owner: src/config/mod.rs.
DATABASE_URL=

# Redis connection URL. Optional; absent or unreachable reports degraded. Owner: src/config/mod.rs.
REDIS_URL=

# MinIO HTTP health endpoint. Optional; absent or unreachable reports degraded. Owner: src/config/mod.rs.
JAMYE_MINIO_HEALTH_URL=

# Account purge grace period in DB-clock days. Optional; default: 30. Owner: src/config/account_deletion.rs.
JAMYE_ACCOUNT_PURGE_GRACE_DAYS=

# Account purge worker batch size. Optional; default: 20. Owner: src/config/account_deletion.rs.
JAMYE_ACCOUNT_PURGE_BATCH_SIZE=

# Account purge worker claim lease in milliseconds. Optional; default: 15000 ms. Owner: src/config/account_deletion.rs.
JAMYE_ACCOUNT_PURGE_LEASE_MS=

# Account purge worker poll interval in milliseconds. Optional; default: 1000 ms. Owner: src/config/account_deletion.rs.
JAMYE_ACCOUNT_PURGE_POLL_INTERVAL_MS=

# Dedicated object-storage credentials used by the account object-deletion worker.
# Required by the worker binary (it fails to start without them); not read by the api binary.
# Owner: src/config/account_deletion.rs.
JAMYE_ACCOUNT_OBJECT_DELETION_ACCESS_KEY_ID=
JAMYE_ACCOUNT_OBJECT_DELETION_SECRET_ACCESS_KEY=

# Enable guarded development fixture routes only in development or test. Optional; default: disabled.
# Owner: src/dev_fixtures/mod.rs. Never enable this in production.
JAMYE_ENABLE_DEV_FIXTURES=

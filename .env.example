# Runtime mode. Required: development, test, or production.
JAMYE_ENVIRONMENT=

# API listen socket in IP:PORT form.
JAMYE_LISTEN_ADDR=

# Grace period allowed for in-flight requests during shutdown.
JAMYE_SHUTDOWN_GRACE_SECONDS=

# Per-dependency readiness probe timeout in milliseconds.
JAMYE_READINESS_TIMEOUT_MS=

# PostgreSQL connection URL. Required and authoritative for readiness.
DATABASE_URL=

# Redis connection URL. Optional in M0; absent or unreachable reports degraded.
REDIS_URL=

# MinIO HTTP health endpoint. Optional in M0; absent or unreachable reports degraded.
JAMYE_MINIO_HEALTH_URL=

# Account purge grace period in DB-clock days. Optional; defaults to 30.
JAMYE_ACCOUNT_PURGE_GRACE_DAYS=

# Account purge worker batch size. Optional; defaults to 20.
JAMYE_ACCOUNT_PURGE_BATCH_SIZE=

# Account purge worker claim lease in milliseconds. Optional; defaults to 15000.
JAMYE_ACCOUNT_PURGE_LEASE_MS=

# Account purge worker poll interval in milliseconds. Optional; defaults to 1000.
JAMYE_ACCOUNT_PURGE_POLL_INTERVAL_MS=

# Object-storage credentials used by the account object-deletion worker.
JAMYE_ACCOUNT_OBJECT_DELETION_ACCESS_KEY_ID=
JAMYE_ACCOUNT_OBJECT_DELETION_SECRET_ACCESS_KEY=

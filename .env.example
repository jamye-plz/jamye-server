# Runtime mode. Required: development, test, or production.
JAMYE_ENVIRONMENT=

# API listen socket in IP:PORT form.
JAMYE_LISTEN_ADDR=

# Grace period allowed for in-flight requests during shutdown.
JAMYE_SHUTDOWN_GRACE_SECONDS=

# Per-dependency readiness probe timeout in milliseconds.
JAMYE_READINESS_TIMEOUT_MS=

# PostgreSQL connection URL. Required and authoritative for readiness.
DATABASE_URL=

# Redis connection URL. Optional in M0; absent or unreachable reports degraded.
REDIS_URL=

# MinIO HTTP health endpoint. Optional in M0; absent or unreachable reports degraded.
JAMYE_MINIO_HEALTH_URL=
